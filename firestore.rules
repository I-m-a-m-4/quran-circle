rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles ──────────────────────────────────────────────────
    // Any authenticated user can read basic profiles (needed for Circle search and accountability)
    // Only the authenticated user can write to their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── User Activity / Sessions ────────────────────────────────────────
    match /users/{userId}/activity/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/sessions/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Circles ─────────────────────────────────────────────────────────
    // A user can read a circle if they are a member
    // A user can write a circle if they are the owner
    match /circles/{circleId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow write: if request.auth != null
                   && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null;

      // Chat messages: any member can read/write
      match /chat/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // ─── Streaks ─────────────────────────────────────────────────────────
    match /streaks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Nudges ──────────────────────────────────────────────────────────
    // Any authenticated user can send a nudge, only recipient can clear it
    match /nudges/{nudgeId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
                                   && request.auth.uid == resource.data.toUid;
    }
  }
}

